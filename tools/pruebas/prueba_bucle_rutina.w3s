# BUCLE DE RUTINA: la lista corre N veces seguidas sin reponer nada entre vueltas ("trasladar, dibujar" x 5 = 5 cubos
# corridos). Se dibujan N veces los triangulos y el campo "repetir" viaja en el .w3d.
# Y el TOTAL del overlay "faces: dibujadas/total" cuenta lo que dibujan las rutinas (antes solo los objetos malla: con
# un escenario unido en rutinas las dibujadas pasaban al total, conversiones/mobile_legend)
rutina Bucle
rutinapaso Bucle array modo=0 on=1
rutinapaso Bucle array modo=1 on=0
rutinapaso Bucle array modo=2 on=0
rutinapaso Bucle array modo=3 on=0
rutinapaso Bucle punteroVertices ref=Cubo
rutinapaso Bucle trasladar n0=2.5 n1=0 n2=0
rutinapaso Bucle dibujar ref=Cubo
tris3d
tris3d
# el objeto Cubo (12) + el cubo de la rutina (12)
carastotal 24
# 5 vueltas: 4 cubos mas (12 triangulos cada uno)
rutinarepetir Bucle 5
tris3d 48
carastotal 72
guardarw3d /tmp/w3d_prueba_bucle.w3d
abrirw3d /tmp/w3d_prueba_bucle.w3d
tris3d 0
carastotal 72

# --- los rangos: el total es SIN recorte (las banderas de un rango array no restan) ---
rutinarepetir Bucle 1
tris3d
# un rango manual: triangulos 2..5 (4) en vez del cubo entero
rutina Rangos
rutinapaso Rangos array modo=0 on=1
rutinapaso Rangos array modo=1 on=0
rutinapaso Rangos array modo=2 on=0
rutinapaso Rangos array modo=3 on=0
rutinapaso Rangos punteroVertices ref=Cubo
rutinapaso Rangos dibujar ref=Cubo rango=1 n0=2 n1=5
tris3d 4
carastotal 28
# un rango array con banderas: [2 rangos, 0..1 con la bandera 0, 6..-1 (hasta el ultimo) con la bandera 1] = 2 + 6
memoria ra 0 2
memoria ra 1 0
memoria ra 2 1
memoria ra 3 0
memoria ra 4 6
memoria ra 5 -1
memoria ra 6 1
memoria rb 0 1
memoria rb 1 1
rutinapaso Rangos dibujar ref=Cubo rango=2 n2=@ra[0] n3=@rb[0]
tris3d 8
carastotal 36
# apagar las dos banderas: se dibujan 8 menos, el total no cambia
memoria rb 0 0
memoria rb 1 0
tris3d -8
carastotal 36
