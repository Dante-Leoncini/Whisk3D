# PINTAR SOBRE EL OBJETO 3D sin textura previa (el cubo por defecto): el primer trazo crea un material propio (el por
# defecto es compartido), despliega UV que no se pisan y crea una textura en memoria ("*"); solo las caras de frente
# quedan pintadas. Despues se guarda dentro del .w3d desde la barra del 3D.
add cube
selobj Cubo.001
mode texture
brushradius 150
brushcolor 0 0 1 1 1
texpaint3d 0 0
texpinturainfo
texcaras 255 255 255
guardarw3d /tmp/w3d_prueba_pintura3d.w3d
w3dpath /tmp/w3d_prueba_pintura3d.w3d
uvguardar3d 1
# --- VELOCIDAD: la textura nueva es de 256x256 y cada toque recorre solo lo que cae bajo el pincel. Un trazo largo
#     (400 movimientos del dedo) tiene que ir sobrado; con la textura de 1024 y el recorrido viejo tardaba ~20 veces mas ---
texpaintrazo 400 120 1500
texpinturainfo
